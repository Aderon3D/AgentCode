<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true" />

        <service
            android:name="com.agent.code.workspace.shizuku.ShizukuCommandService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="moe.shizuku.agent.IShizukuCommandExecutor" />
            </intent-filter>
            <meta-data
                android:name="moe.shizuku.manager.service.tag"
                android:value="agent-code-executor" />
            <meta-data
                android:name="moe.shizuku.manager.service.version"
                android:value="1" />
        </service>
    </application>

</manifest>
